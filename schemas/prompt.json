{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/LodyAI/awesome-lody/schemas/prompt.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "prompt"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 240
    },
    "promptFile": {
      "$ref": "common.json#/definitions/path"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "name",
    "promptFile",
    "slug"
  ]
}
