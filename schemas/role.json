{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/LodyAI/awesome-lody/schemas/role.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "role"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 140
    },
    "promptFile": {
      "$ref": "common.json#/definitions/path"
    },
    "recommended": {
      "$ref": "common.json#/definitions/recommended"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "name",
    "promptFile"
  ]
}
